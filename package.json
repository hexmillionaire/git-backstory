{
  "name": "git-backstory",
  "version": "0.1.0",
  "description": "The backstory of a file, in one page, for whoever has to change it next: reverts, fix bursts, reasons from commit bodies, co-changed files and owners, from git log and git blame. Zero dependencies.",
  "type": "module",
  "bin": {
    "git-backstory": "bin/git-backstory.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "llms.txt",
    "skills"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/analyze.test.js test/cli.test.js test/untrusted-repo.test.js",
    "try": "node bin/git-backstory.js src/cli.js"
  },
  "keywords": [
    "git",
    "git-log",
    "git-blame",
    "history",
    "code-archaeology",
    "ai-coding",
    "claude-code",
    "cursor",
    "codex",
    "copilot",
    "agents",
    "context-engineering",
    "cli",
    "developer-tools",
    "zero-dependencies",
    "backstory"
  ],
  "author": "Amado (hexmillionaire)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmillionaire/git-backstory.git"
  },
  "homepage": "https://github.com/hexmillionaire/git-backstory#readme",
  "bugs": {
    "url": "https://github.com/hexmillionaire/git-backstory/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
